{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "clipcraft": {
      "projectType": "application", "root": "", "sourceRoot": "src", "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": { "outputPath": "dist/clipcraft", "index": "src/index.html", "browser": "src/main.ts", "polyfills": ["zone.js"], "tsConfig": "tsconfig.app.json", "assets": [{ "glob": "**/*", "input": "public", "output": "/" }], "styles": ["src/styles.css"] },
          "configurations": { "production": { "optimization": true, "outputHashing": "all", "budgets": [{ "type": "initial", "maximumWarning": "650kB", "maximumError": "1.2MB" }] }, "development": { "optimization": false, "sourceMap": true, "extractLicenses": false } },
          "defaultConfiguration": "development"
        },
        "serve": { "builder": "@angular-devkit/build-angular:dev-server", "configurations": { "production": { "buildTarget": "clipcraft:build:production" }, "development": { "buildTarget": "clipcraft:build:development" } }, "defaultConfiguration": "development" }
      }
    }
  },
  "cli": { "analytics": false }
}
